# 服务
PORT=3000
HOST=0.0.0.0
TZ_NAME=Asia/Shanghai
LOG_LEVEL=info

# 数据库（相对路径按项目根目录解析）
DB_PATH=./fund.db

# 局域网访问口令：留空则不校验；填了之后前端会提示输入，或请求头带 X-API-Token
API_TOKEN=

# 净值抓取
FETCH_TIMEOUT_MS=8000
FETCH_RETRIES=2
FETCH_CONCURRENCY=3
QUOTE_CACHE_MS=600000
DETAIL_CACHE_DAYS=7

# 大模型问答（可选）：留空则只用本地规则回答
# OpenAI 兼容接口，例如豆包方舟 https://ark.cn-beijing.volces.com/api/v3
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=doubao-seed-1-6-250615
AI_TIMEOUT_MS=25000

# 通知（可选）
SERVERCHAN_KEY=
NOTIFY_DESKTOP=false

# 自动备份
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_KEEP=14

.sum-item { padding: 14rpx 16rpx; border-radius: 12rpx; background: #f8fbfd; }
.sum-value { display: block; margin-top: 4rpx; font-size: 29rpx; font-weight: 700; }
.add-btn { margin-top: 16rpx; }
.holding-name { font-size: 28rpx; font-weight: 700; flex: 1; }
.value-line { display: flex; justify-content: space-between; gap: 16rpx; padding: 18rpx 0 12rpx; border-bottom: 1rpx dashed #edf2f7; }
.value-label { font-size: 21rpx; color: #7b8b9a; }
.value-main { font-size: 31rpx; font-weight: 700; }
.value-right { text-align: right; }
.detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8rpx 18rpx; padding: 14rpx 0; font-size: 22rpx; }
.detail-grid text { display: block; color: #102033; margin-top: 2rpx; }
.action-box { margin-top: 10rpx; padding: 14rpx; border-radius: 12rpx; background: #f8fbfd; }
.action-title { font-size: 24rpx; font-weight: 700; color: #0f5f5a; }
.trigger-row { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }
.trigger { font-size: 20rpx; color: #155e75; background: #edf7fa; padding: 4rpx 10rpx; border-radius: 8rpx; }
.btn-row { margin-top: 16rpx; flex-wrap: wrap; justify-content: flex-start; }
.foot-note { text-align: center; margin: 22rpx 0 10rpx; color: #9aa8b4; }

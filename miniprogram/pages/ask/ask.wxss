.ask-container { padding-bottom: 40rpx; }
.ask-head { border-top: 5rpx solid #0f766e; }
.code-input { flex: 1; }
.head-hint { margin-top: 10rpx; }
.quick-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 4rpx 0 20rpx; }
.quick-chip { padding: 10rpx 16rpx; border-radius: 999rpx; background: #ffffff; border: 1rpx solid #d8e3ec; font-size: 22rpx; color: #31465a; }
.msg { margin-bottom: 20rpx; }
.msg.user { display: flex; flex-direction: column; align-items: flex-end; }
.msg.bot { display: flex; flex-direction: column; align-items: flex-start; }
.msg-meta { font-size: 21rpx; color: #8a9aa8; margin: 0 8rpx 6rpx; }
.bubble { max-width: 86%; padding: 18rpx 20rpx; border-radius: 16rpx; position: relative; }
.bubble.user { background: #0f766e; color: #ffffff; border-bottom-right-radius: 4rpx; }
.bubble.bot { background: #ffffff; border: 1rpx solid #e5edf4; border-bottom-left-radius: 4rpx; box-shadow: 0 8rpx 22rpx rgba(15, 42, 66, 0.04); }
.bubble .pre-wrap { font-size: 25rpx; line-height: 1.75; }
.bubble.user .pre-wrap { color: #ffffff; }
.bubble.bot .pre-wrap { color: #1e293b; }
.check-mini { margin-top: 14rpx; padding: 12rpx; border-radius: 10rpx; background: #f8fbfd; }
.mini-name { font-size: 23rpx; font-weight: 700; }
.mini-btn { margin-top: 10rpx; }
.copy { margin-top: 8rpx; text-align: right; font-size: 20rpx; color: #7b8b9a; }
.typing { padding: 0 8rpx 18rpx; font-size: 22rpx; color: #7b8b9a; }
.input-card { margin-top: 10rpx; }
.ask-input { width: 100%; min-height: 120rpx; padding: 14rpx; border: 1rpx solid #d8e3ec; border-radius: 12rpx; font-size: 25rpx; box-sizing: border-box; background: #ffffff; }
.input-actions { margin-top: 12rpx; }
.send-btn { min-width: 150rpx; }

page {
  background: #f4f7fb;
  color: #14202e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx 24rpx 64rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e5edf4;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 42, 66, 0.05);
  box-sizing: border-box;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
  color: #102033;
  margin-bottom: 18rpx;
}

.section-title text {
  font-size: 22rpx;
  font-weight: 400;
  color: #7b8b9a;
}

.muted {
  color: #7b8b9a;
  font-size: 23rpx;
  line-height: 1.65;
}

.tiny {
  color: #7b8b9a;
  font-size: 21rpx;
  line-height: 1.55;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 26rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #0f5f5a;
  background: #e8f7f4;
  border: 1rpx solid #bfe8df;
  line-height: 1.2;
  margin: 0;
}

.btn::after { border: none; }

.btn.primary {
  background: #0f766e;
  border-color: #0f766e;
  color: #ffffff;
}

.btn.ghost {
  background: #ffffff;
  border-color: #d8e3ec;
  color: #31465a;
}

.btn.danger {
  background: #fff1f0;
  border-color: #fecdca;
  color: #b42318;
}

.btn.small {
  min-height: 54rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

.btn.full { width: 100%; }

.chip {
  display: inline-flex;
  align-items: center;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.5;
  white-space: nowrap;
}

.chip.good { background: #ecfdf3; color: #067647; }
.chip.warn { background: #fff6e6; color: #9a5b00; }
.chip.danger { background: #fff1f0; color: #b42318; }
.chip.info { background: #edf7fa; color: #155e75; }
.chip.plain { background: #f1f5f9; color: #64748b; }

.positive { color: #b42318; }
.negative { color: #067647; }
.neutral { color: #475569; }

.empty {
  padding: 40rpx 20rpx;
  text-align: center;
  color: #8a9aa8;
  font-size: 24rpx;
}

.divider {
  height: 1rpx;
  background: #edf2f7;
  margin: 18rpx 0;
}

.input {
  width: 100%;
  min-height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d8e3ec;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 26rpx;
  color: #102033;
  box-sizing: border-box;
}

.field { margin-bottom: 18rpx; }
.field-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 23rpx;
  color: #52677a;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.notice {
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #fff8e8;
  color: #7a4a00;
  font-size: 23rpx;
  line-height: 1.6;
}

.notice.error { background: #fff1f0; color: #b42318; }
.notice.info { background: #edf7fa; color: #155e75; }
.notice.ok { background: #ecfdf3; color: #067647; }

.action-link {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 600;
}

.pre-wrap { white-space: pre-wrap; word-break: break-all; }
